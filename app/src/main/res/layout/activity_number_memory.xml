<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101426"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/numberMemoryRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Screen Heading -->
        <TextView
            android:id="@+id/tvNumberMemoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="←  Number Memory"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="20dp" />

        <!-- Instructions -->
        <TextView
            android:id="@+id/tvNumberInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memorize the number carefully and enter it after it disappears."
            android:textColor="#D0D5E8"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:paddingBottom="18dp" />

        <!-- Game Status -->
        <TextView
            android:id="@+id/tvNumberGameStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready when you are"
            android:textColor="#AFA8FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp" />

        <!-- Round Information -->
        <TextView
            android:id="@+id/tvNumberRound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Round: 1"
            android:textColor="#D0D5E8"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="8dp" />

        <!-- Number Display Area -->
        <TextView
            android:id="@+id/tvNumberDisplay"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="#272F49"
            android:text="----"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvNumberTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Timer: --"
            android:textColor="#AFA8FF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Player Answer -->
        <TextView
            android:id="@+id/tvNumberAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B2540"
            android:text="Your answer: "
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Custom Numeric Keypad -->
        <GridLayout
            android:id="@+id/numberKeypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <Button
                android:id="@+id/btnKey1"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_columnWeight="1"
                android:text="1"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#272F49" />

            <Button
                android:id="@+id/btnKey2"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_columnWeight="1"
                android:text="2"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#272F49" />

            <Button
                android:id="@+id/btnKey3"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_columnWeight="1"
                android:text="3"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#272F49" />

            <Button
                android:id="@+id/btnKey4"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_columnWeight="1"
                android:text="4"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#272F49" />

            <Button
                android:id="@+id/btnKey5"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_columnWeight="1"
                android:text="5"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#272F49" />

            <Button
                android:id="@+id/btnKey6"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_columnWeight="1"
                android:text="6"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#272F49" />

            <Button
                android:id="@+id/btnKey7"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_columnWeight="1"
                android:text="7"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#272F49" />

            <Button
                android:id="@+id/btnKey8"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_columnWeight="1"
                android:text="8"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#272F49" />

            <Button
                android:id="@+id/btnKey9"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_columnWeight="1"
                android:text="9"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#272F49" />

            <!-- Delete -->
            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_columnWeight="1"
                android:text="⌫"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4A355A" />

            <!-- Zero -->
            <Button
                android:id="@+id/btnKey0"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_columnWeight="1"
                android:text="0"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#272F49" />

            <!-- Submit -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_columnWeight="1"
                android:text="✓"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6257C8" />

        </GridLayout>

        <!-- Result -->
        <TextView
            android:id="@+id/tvNumberResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp" />

        <!-- Start / Restart -->
        <Button
            android:id="@+id/btnStartNumberGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Test"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:padding="8dp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnNumberMemoryHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Game History"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:backgroundTint="#6257C8"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
